💻 3. Starter Code Skeleton
======================================================================
Use the following skeleton to implement your solution. Fill in the missing parts.

python
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score

# ---- 1. Load dataset (use the generation code above) ----
# (Insert dataset generation code here)

# ---- 2. Define features and target ----
X = df[['Size']]   # start with just Size
y = df['Price']

# ---- 3. Function to compute metrics ----
def compute_metrics(X, y):
    model = LinearRegression()
    model.fit(X, y)
    y_pred = model.predict(X)
    r2 = r2_score(y, y_pred)
    n = len(y)
    k = X.shape[1]
    adj_r2 = 1 - (1 - r2) * (n - 1) / (n - k - 1)
    return r2, adj_r2, k

# ---- 4. Build models sequentially ----
# Model 1: Size
X1 = df[['Size']]
r2_1, adj_1, k_1 = compute_metrics(X1, y)

# Model 2: Size + Bedrooms
X2 = df[['Size', 'Bedrooms']]
r2_2, adj_2, k_2 = compute_metrics(X2, y)

# ... continue for all 6 models

# ---- 5. Print results ----
print(f"Model 1: R²={r2_1:.4f}, Adj R²={adj_1:.4f}, k={k_1}")
print(f"Model 2: R²={r2_2:.4f}, Adj R²={adj_2:.4f}, k={k_2}")
# ... print all models

