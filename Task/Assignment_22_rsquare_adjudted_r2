    'Size': size,
    'Bedrooms': bedrooms,
    'Bathrooms': bathrooms,
    'Age': age,
    'LotSize': lot_size,
    'Garage': garage,
    'Price': price
})

print(df.head())
print("Shape:", df.shape)

